{
    "name": "suburban-cm-theme",
    "version": "1.0.0",
    "description": "A custom WordPress theme with Tailwind CSS and block building setup.",
    "scripts": {
        "start": "wp-scripts start --webpack-config=webpack.config.js --webpack-src-dir=src",
        "build": "npm-run-all build:webpack build:css build:global-css",
        "build:webpack": "wp-scripts build --webpack-config=webpack.config.js --webpack-src-dir=src",
        "build:css": "postcss src/blocks/**/style.scss --base src/blocks --dir build/blocks --ext .css",
        "watch:css": "postcss src/blocks/**/style.scss --base src/blocks --dir build/blocks --ext .css --watch",
        "build:global-css": "postcss assets/css/src/*.scss --ext .css --dir assets/css/dist/",
        "watch:global-css": "postcss assets/css/src/*.scss --ext .css --dir assets/css/dist/ --watch",
        "clean:blocks": "rimraf ./build/*",
        "create:block": "cd src/blocks && npx @wordpress/create-block@latest --template ./_template --no-plugin",
        "dev": "npm-run-all start watch:global-css watch:css",
        "prod": "npm run build"
    },
    "devDependencies": {
        "@wordpress/scripts": "^26.18.0",
        "autoprefixer": "^10.4.21",
        "css-loader": "^6.8.1",
        "mini-css-extract-plugin": "^2.7.6",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.4.24",
        "postcss-cli": "^11.0.1",
        "postcss-loader": "^7.3.3",
        "postcss-scss": "^4.0.9",
        "sass": "^1.87.0",
        "sass-loader": "^13.3.3",
        "style-loader": "^4.0.0",
        "tailwindcss": "^3.4.17"
    },
    "browserslist": [
        "defaults"
    ],
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
        "@tailwindcss/postcss": "^4.1.5",
        "@wordpress/icons": "^10.24.0",
        "postcss-import": "^16.1.0",
        "postcss-import-ext-glob": "^2.1.1",
        "postcss-nesting": "^13.0.1"
    },
    "prettier": "@wordpress/prettier-config"
}
