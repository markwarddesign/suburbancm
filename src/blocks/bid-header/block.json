{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suburbancm/bid-header",
	"version": "0.1.0",
	"title": "Bid Header",
	"icon": "admin-site-alt3",
	"category": "suburban",
	"description": "Project header with editable title and button.",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"buttonText": {
			"type": "string",
			"default": "Submit Bid"
		},
		"buttonUrl": {
			"type": "string",
			"default": ""
		},
		"hideBreadcrumb": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"align": [
			"full",
			"wide"
		]
	},
	"textdomain": "suburbancm",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./view.php",
	"viewScript": "file:./view.js"
}