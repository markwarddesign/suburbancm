{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "suburbancm/image-text-intro",
  "version": "0.1.0",
  "title": "Split Text",
  "category": "suburban",
  "icon": "format-image",
  "description": "Two columns: a big heading (with an optional logo or image under it) beside a bold lead line, paragraphs and optional tag chips. Light or charcoal.",
  "attributes": {
    "image": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": "Team collaborating on project plans"
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "lead": {
      "type": "string",
      "default": ""
    },
    "chipsLabel": {
      "type": "string",
      "default": ""
    },
    "chips": {
      "type": "array",
      "default": []
    },
    "chipLinks": {
      "type": "array",
      "default": []
    },
    "background": {
      "type": "string",
      "default": "bone",
      "enum": [
        "bone",
        "ink"
      ]
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "textdomain": "suburbancm",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./view.php"
}