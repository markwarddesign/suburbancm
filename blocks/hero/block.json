{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "suburbancm/hero",
    "version": "1.0.0",
    "title": "Suburban Primary Hero",
    "category": "design",
    "icon": "cover-image",
    "description": "A hero section with heading, paragraph, two buttons, and optional background image.",
    "attributes": {
      "headingLine1": {
        "type": "string",
        "source": "html",
        "selector": "h1",
        "default": "Building Your Vision, "
      },
      "headingHighlight": {
        "type": "string",
        "source": "html",
        "selector": "h1 span",
        "default": "Managing Every Detail"
      },
      "paragraph": {
        "type": "string",
        "source": "html",
        "selector": "p",
        "default": "Expert construction management services ensuring your project is completed on time, within budget, and to the highest standards."
      },
      "button1Text": {
        "type": "string",
        "source": "text",
        "selector": ".wp-block-custom-blocks-hero-section-button1",
        "default": "Request a Consultation"
      },
      "button1Link": {
        "type": "string",
        "attribute": "href",
        "selector": ".wp-block-custom-blocks-hero-section-button1",
        "default": "#cta1"
      },
      "button2Text": {
        "type": "string",
        "source": "text",
        "selector": ".wp-block-custom-blocks-hero-section-button2",
        "default": "View Our Projects"
      },
      "button2Link": {
        "type": "string",
        "attribute": "href",
        "selector": ".wp-block-custom-blocks-hero-section-button2",
        "default": "#projects"
      },
      "backgroundImageId": {
        "type": "number"
      },
      "backgroundImageUrl": {
        "type": "string",
        "source": "attribute",
        "selector": "section",
        "attribute": "data-background-image-url",
        "default": ""
      }
    },
    "supports": {
      "html": false,
      "align": [ "full", "wide" ]
    },
  "textdomain": "suburbancm",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./hero.php"
}