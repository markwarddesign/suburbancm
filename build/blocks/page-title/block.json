{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "suburbancm/page-title",
  "version": "0.1.0",
  "title": "Page Title",
  "category": "suburban",
  "icon": "heading",
  "description": "A block for displaying a page title with a subtitle.",
  "attributes": {
    "title": {
      "type": "string",
      "default": "About <span class='text-brand-accent dark:text-brand-text-dark'>SuburbanCM</span>"
    },
    "subtitle": {
      "type": "string",
      "default": "Building lasting relationships through quality construction and expert management since [Year Founded]."
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "textdomain": "suburbancm",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./view.php",
  "viewScript": "file:./view.js"
}