{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "suburbancm/page-title",
  "version": "0.1.0",
  "title": "Page Title",
  "category": "suburban",
  "icon": "heading",
  "description": "Top of an inner page: big headline with an optional gold second line, intro text, optional tagline and button, and an optional full-width photo below. Can sit on charcoal or gold.",
  "attributes": {
    "title": {
      "type": "string",
      "default": "About <span class='text-brand-accent dark:text-brand-text-dark'>SuburbanCM</span>"
    },
    "subtitle": {
      "type": "string",
      "default": "Building lasting relationships through quality construction and expert management since [Year Founded]."
    },
    "titleHighlight": {
      "type": "string",
      "default": ""
    },
    "tagline": {
      "type": "string",
      "default": ""
    },
    "background": {
      "type": "string",
      "default": "ink",
      "enum": [
        "ink",
        "gold"
      ]
    },
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number"
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "textdomain": "suburbancm",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./view.php"
}