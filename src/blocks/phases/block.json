{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "suburbancm/phases",
	"version": "0.1.0",
	"title": "Process Phases",
	"category": "suburban",
	"icon": "schedule",
	"description": "A section heading, then each phase as a huge gold \"Phase\" label and title beside a grid of steps.",
	"attributes": {
		"phases": {
			"type": "array",
			"default": []
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"description": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"align": [
			"full",
			"wide"
		]
	},
	"textdomain": "suburbancm",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./editor.css",
	"style": "file:./style.css",
	"render": "file:./view.php"
}
