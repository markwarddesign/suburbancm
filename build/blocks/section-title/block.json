{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "suburbancm/section-title",
  "version": "0.1.0",
  "title": "Section Title",
  "category": "suburban",
  "icon": "editor-textcolor",
  "description": "A heading (h1-h5) with an optional description.",
  "keywords": [
    "heading",
    "title",
    "section",
    "description"
  ],
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "level": {
      "type": "number",
      "default": 2
    },
    "align": {
      "type": "string",
      "default": "center"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "textdomain": "suburbancm",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./view.php",
  "viewScript": "file:./view.js"
}