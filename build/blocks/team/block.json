{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "suburbancm/team",
  "version": "0.1.0",
  "title": "Team",
  "category": "suburban",
  "icon": "heart",
  "description": "Team members from the Team post type, each as a large photo beside their role, name, short bio and links.",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "hideTitle": {
      "type": "boolean",
      "default": false
    },
    "showAll": {
      "type": "boolean",
      "default": true
    },
    "selectedTeamMembers": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    },
    "ctaText": {
      "type": "string",
      "default": "Schedule a consultation"
    },
    "ctaUrl": {
      "type": "string",
      "default": "/contact/"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "textdomain": "team",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style.css",
  "render": "file:./view.php"
}