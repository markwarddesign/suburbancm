{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "cards/cards",
  "version": "0.1.0",
  "title": "Cards",
  "category": "theme",
  "icon": "screenoptions",
  "description": "A bootstrapped block. Build something beautiful!",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "cards": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "default": ""
          },
          "cardTitle": {
            "type": "string",
            "default": ""
          },
          "description": {
            "type": "string",
            "default": ""
          }
        }
      }
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full",
      "wide"
    ]
  },
  "textdomain": "suburbancm",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./editor.css",
  "style": "file:./style.css",
  "render": "file:./view.php",
  "viewScript": "file:./view.js"
}