{
    "$schema": "https://schemas.wp.org/wp/6.4/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "color": {
            "custom": false,
            "customDuotone": false,
            "customGradient": false,
            "defaultPalette": false,
            "defaultGradients": false,
            "defaultDuotone": false,
            "palette": [
                {
                    "color": "#1f1f1f",
                    "name": "Dark Gray",
                    "slug": "dark-gray"
                },
                {
                    "color": "#2a2a2a",
                    "name": "Medium Gray",
                    "slug": "medium-gray"
                },
                {
                    "color": "#e4d198",
                    "name": "Gold",
                    "slug": "gold"
                },
                {
                    "color": "#80703a",
                    "name": "Dark Gold",
                    "slug": "dark-gold"
                },
                {
                    "color": "#a38f50",
                    "name": "Medium Gold",
                    "slug": "medium-gold"
                },
                {
                    "color": "#f6f5ec",
                    "name": "Light Gold",
                    "slug": "light-gold"
                },
                {
                    "color": "#000000",
                    "name": "Black",
                    "slug": "black"
                },
                {
                    "color": "#ffffff",
                    "name": "White",
                    "slug": "white"
                },
                {
                    "color": "transparent",
                    "name": "Transparent",
                    "slug": "transparent"
                }
            ]
        },
        "layout": {
            "contentSize": "80rem",
            "wideSize": "100rem"
        },
        "typography": {
            "fontFamilies": [
                {
                    "fontFamily": "'Inter', sans-serif",
                    "name": "Inter",
                    "slug": "inter",
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontWeight": "100 900",
                            "fontStyle": "normal",
                            "fontDisplay": "swap",
                            "src": [ "https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" ]
                        }
                    ]
                }
            ],
            "fluid": true,
            "fontSizes": [
                { "slug": "xs", "size": "0.75rem", "name": "Extra Small" },
                { "slug": "sm", "size": "0.875rem", "name": "Small" },
                { "slug": "base", "size": "1rem", "name": "Base" },
                { "slug": "lg", "size": "1.125rem", "name": "Large" },
                { "slug": "xl", "size": "1.25rem", "name": "XL" },
                { "slug": "2xl", "size": "1.5rem", "name": "2XL" },
                { "slug": "3xl", "size": "1.875rem", "name": "3XL" },
                { "slug": "4xl", "size": "2.25rem", "name": "4XL" },
                { "slug": "5xl", "size": "3rem", "name": "5XL" },
                { "slug": "6xl", "size": "3.75rem", "name": "6XL" },
                { "slug": "7xl", "size": "4.5rem", "name": "7XL" }
            ]
        },
        "spacing": {
            "units": [ "%", "px", "em", "rem", "vh", "vw" ],
            "spacingScale": {
                "steps": 20
            },
            "blockGap": "1.5rem"
        },
        "blocks": {
            "core/button": {
                "spacing": {
                    "padding": {
                        "top": "0.75rem", "bottom": "0.75rem", "left": "2rem", "right": "2rem"
                    }
                },
                "border": {
                    "radius": "0.375rem"
                },
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--lg)"
                }
            }
        }
    },
    "styles": {
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--inter)",
            "fontSize": "var(--wp--preset--font-size--base)",
            "lineHeight": "1.5"
        },
        "elements": {
            "link": {
                "color": { "text": "var(--wp--preset--color--medium-gold)" },
                ":hover": { "color": { "text": "var(--wp--preset--color--dark-gold)" } }
            }
        }
    }
}